generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admins {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name                  String    @db.VarChar(255)
  email                 String    @unique(map: "admins_email_unique") @db.VarChar(255)
  image                 String?   @db.VarChar(255)
  password              String    @db.VarChar(255)
  bio                   String?   @db.Text
  status                String    @default("active") @db.VarChar(255)
  created_at            DateTime? @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)
  forget_password_token String?   @db.VarChar(255)
}

model ai_chat_messages {
  id              BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  thread_id       BigInt                @db.UnsignedBigInt
  role            ai_chat_messages_role
  message         String                @db.LongText
  created_at      DateTime?             @db.Timestamp(0)
  updated_at      DateTime?             @db.Timestamp(0)
  ai_chat_threads ai_chat_threads       @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_chat_messages_thread_id_foreign")

  @@index([thread_id], map: "ai_chat_messages_thread_id_foreign")
}

model ai_chat_threads {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  user_id          BigInt             @db.UnsignedBigInt
  title            String?            @db.VarChar(255)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  ai_chat_messages ai_chat_messages[]
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_chat_threads_user_id_foreign")

  @@index([user_id], map: "ai_chat_threads_user_id_foreign")
}

model ai_knowledge_chunks {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  source     String    @db.VarChar(255)
  content    String    @db.LongText
  embedding  Json
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model announcements {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_id     BigInt    @db.UnsignedBigInt
  instructor_id BigInt    @db.UnsignedBigInt
  title         String    @db.VarChar(255)
  announcement  String    @db.Text
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
}

model badges {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  key            String    @db.VarChar(255)
  image          String    @db.VarChar(255)
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  condition_from Int       @default(0)
  condition_to   Int       @default(0)
  status         Boolean   @default(true)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
}

model banned_histories {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     Int
  subject     String?   @db.VarChar(255)
  reasone     String?   @db.VarChar(255)
  description String?   @db.Text
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model basic_payments {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  key        String    @db.VarChar(255)
  value      String    @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model bkash_p_g_models {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  key        String    @db.VarChar(255)
  value      String    @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model blog_categories {
  id                         BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  slug                       String                       @db.VarChar(255)
  position                   Int                          @default(0)
  parent_id                  String?                      @db.VarChar(255)
  status                     Boolean                      @default(true)
  created_at                 DateTime?                    @db.Timestamp(0)
  updated_at                 DateTime?                    @db.Timestamp(0)
  blog_category_translations blog_category_translations[]
}

model blog_category_translations {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  blog_category_id  BigInt          @db.UnsignedBigInt
  lang_code         String          @db.VarChar(255)
  title             String          @db.VarChar(255)
  short_description String?         @db.VarChar(255)
  created_at        DateTime?       @db.Timestamp(0)
  updated_at        DateTime?       @db.Timestamp(0)
  blog_categories   blog_categories @relation(fields: [blog_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "blog_category_translations_blog_category_id_foreign")

  @@index([blog_category_id], map: "blog_category_translations_blog_category_id_foreign")
}

model blog_comments {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  blog_id    BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  name       String?   @db.VarChar(255)
  email      String?   @db.VarChar(255)
  phone      String?   @db.VarChar(255)
  comment    String    @db.Text
  status     Boolean   @default(false)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model blog_translations {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  blog_id         BigInt    @db.UnsignedBigInt
  lang_code       String    @db.VarChar(255)
  title           String    @db.VarChar(255)
  description     String    @db.LongText
  seo_title       String?   @db.Text
  seo_description String?   @db.Text
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
}

model blogs {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  admin_id         BigInt    @default(0) @db.UnsignedBigInt
  blog_category_id BigInt    @db.UnsignedBigInt
  slug             String    @db.Text
  image            String?   @db.VarChar(255)
  views            BigInt    @default(0)
  show_homepage    Boolean   @default(false)
  is_popular       Boolean   @default(false)
  tags             String?   @db.Text
  status           Boolean   @default(false)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
}

model brands {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  image      String    @db.VarChar(255)
  url        String    @db.VarChar(255)
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model career_applications {
  id              BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  career_id       BigInt                     @db.UnsignedBigInt
  name            String                     @db.VarChar(255)
  email           String                     @db.VarChar(255)
  phone           String                     @db.VarChar(255)
  experience      String?                    @db.VarChar(255)
  current_company String?                    @db.VarChar(255)
  expected_salary String?                    @db.VarChar(255)
  resume          String                     @db.VarChar(255)
  cover_letter    String?                    @db.LongText
  status          career_applications_status @default(pending)
  created_at      DateTime?                  @db.Timestamp(0)
  updated_at      DateTime?                  @db.Timestamp(0)
  careers         careers                    @relation(fields: [career_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "career_applications_career_id_foreign")

  @@index([career_id], map: "career_applications_career_id_foreign")
}

model careers {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  title               String                @db.VarChar(255)
  slug                String                @unique(map: "careers_slug_unique") @db.VarChar(255)
  department          String?               @db.VarChar(255)
  location            String?               @db.VarChar(255)
  employment_type     String?               @db.VarChar(255)
  experience          String?               @db.VarChar(255)
  salary              String?               @db.VarChar(255)
  vacancies           Int                   @default(1) @db.UnsignedInt
  description         String?               @db.LongText
  requirements        String?               @db.LongText
  responsibilities    String?               @db.LongText
  benefits            String?               @db.LongText
  status              careers_status        @default(draft)
  is_featured         Boolean               @default(false)
  is_urgent           Boolean               @default(false)
  is_remote           Boolean               @default(false)
  published_at        DateTime?             @db.Timestamp(0)
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  deleted_at          DateTime?             @db.Timestamp(0)
  career_applications career_applications[]
}

model carts {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  course_id  BigInt?   @db.UnsignedBigInt
  qty        Int       @default(1)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  note_id    BigInt?   @db.UnsignedBigInt
  type       String?   @default("course") @db.VarChar(20)
  courses    courses?  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "carts_course_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "carts_user_id_foreign")

  @@index([course_id], map: "carts_course_id_foreign")
  @@index([user_id], map: "carts_user_id_foreign")
}

model certificate_builder_items {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  element_id String?   @db.VarChar(255)
  x_position String?   @db.VarChar(255)
  y_position String?   @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model certificate_builders {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  background  String?   @db.VarChar(255)
  title       String?   @db.VarChar(255)
  sub_title   String?   @db.VarChar(255)
  description String?   @db.Text
  signature   String?   @db.VarChar(255)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model cities {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  state_id   BigInt    @db.UnsignedBigInt
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  states     states    @relation(fields: [state_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cities_state_id_foreign")

  @@index([state_id], map: "cities_state_id_foreign")
}

model class_subjects {
  id         BigInt    @id @default(autoincrement())
  class_id   String?   @db.VarChar(10)
  subject_id BigInt?
  subjects   subjects? @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "class_subjects_ibfk_1")

  @@index([subject_id], map: "subject_id")
}

model configurations {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  config     String    @db.VarChar(255)
  value      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model contact_messages {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  email      String?   @db.VarChar(255)
  phone      String?   @db.VarChar(255)
  subject    String?   @db.VarChar(255)
  message    String    @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model contact_sections {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  address    String?   @db.VarChar(255)
  phone_one  String?   @db.VarChar(255)
  phone_two  String?   @db.VarChar(255)
  email_one  String?   @db.VarChar(255)
  email_two  String?   @db.VarChar(255)
  map        String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model countries {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  states     states[]
}

model coupon_histories {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  author_id       Int       @default(0)
  user_id         Int       @default(0)
  coupon_code     String    @db.VarChar(255)
  coupon_id       Int
  discount_amount Decimal   @db.Decimal(8, 2)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
}

model coupons {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  author_id        Int            @default(0)
  coupon_code      String         @db.VarChar(255)
  offer_percentage Decimal        @db.Decimal(8, 2)
  expired_date     String         @db.VarChar(255)
  status           coupons_status @default(active)
  created_at       DateTime?      @db.Timestamp(0)
  updated_at       DateTime?      @db.Timestamp(0)
  min_price        Decimal        @db.Decimal(8, 2)
}

model course_categories {
  id                                                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  slug                                               String?   @db.VarChar(255)
  order                                              Int?
  icon                                               String?   @db.VarChar(255)
  parent_id                                          BigInt?   @db.UnsignedBigInt
  show_at_trending                                   Boolean?
  status                                             Boolean   @default(true)
  created_at                                         DateTime? @db.Timestamp(0)
  updated_at                                         DateTime? @db.Timestamp(0)
  ebooks                                             ebooks[]
  notes_notes_class_category_idTocourse_categories   notes[]   @relation("notes_class_category_idTocourse_categories")
  notes_notes_subject_category_idTocourse_categories notes[]   @relation("notes_subject_category_idTocourse_categories")
}

model course_category_translations {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_category_id BigInt    @db.UnsignedBigInt
  lang_code          String    @db.VarChar(255)
  name               String    @db.VarChar(255)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
}

model course_chapter_items {
  id                     BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  instructor_id          BigInt                     @db.UnsignedBigInt
  chapter_id             BigInt                     @db.UnsignedBigInt
  type                   course_chapter_items_type? @default(lesson)
  order                  Int
  created_at             DateTime?                  @db.Timestamp(0)
  updated_at             DateTime?                  @db.Timestamp(0)
  course_chapters        course_chapters            @relation(fields: [chapter_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "course_chapter_items_chapter_id_foreign")
  users                  users                      @relation(fields: [instructor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "course_chapter_items_instructor_id_foreign")
  course_chapter_lessons course_chapter_lessons[]

  @@index([chapter_id], map: "course_chapter_items_chapter_id_foreign")
  @@index([instructor_id], map: "course_chapter_items_instructor_id_foreign")
}

model course_chapter_lessons {
  id                   BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  title                String                            @db.VarChar(255)
  slug                 String?                           @db.VarChar(255)
  description          String?                           @db.Text
  instructor_id        BigInt                            @db.UnsignedBigInt
  course_id            BigInt                            @db.UnsignedBigInt
  chapter_id           BigInt                            @db.UnsignedBigInt
  chapter_item_id      BigInt                            @db.UnsignedBigInt
  file_path            String?                           @db.Text
  storage              course_chapter_lessons_storage?   @default(upload)
  volume               String?                           @db.VarChar(255)
  duration             String?                           @db.VarChar(255)
  file_type            course_chapter_lessons_file_type? @default(video)
  downloadable         Boolean                           @default(true)
  order                Int?
  is_free              Boolean?                          @default(false)
  status               course_chapter_lessons_status     @default(active)
  created_at           DateTime?                         @db.Timestamp(0)
  updated_at           DateTime?                         @db.Timestamp(0)
  course_chapters      course_chapters                   @relation(fields: [chapter_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "course_chapter_lessons_chapter_id_foreign")
  course_chapter_items course_chapter_items              @relation(fields: [chapter_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "course_chapter_lessons_chapter_item_id_foreign")
  users                users                             @relation(fields: [instructor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "course_chapter_lessons_instructor_id_foreign")
  course_live_classes  course_live_classes[]
  lesson_recordings    lesson_recordings[]

  @@index([chapter_id], map: "course_chapter_lessons_chapter_id_foreign")
  @@index([chapter_item_id], map: "course_chapter_lessons_chapter_item_id_foreign")
  @@index([instructor_id], map: "course_chapter_lessons_instructor_id_foreign")
}

model course_chapters {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  title                  String                   @db.VarChar(255)
  instructor_id          BigInt                   @db.UnsignedBigInt
  course_id              BigInt                   @db.UnsignedBigInt
  order                  Int
  status                 course_chapters_status   @default(active)
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @db.Timestamp(0)
  course_chapter_items   course_chapter_items[]
  course_chapter_lessons course_chapter_lessons[]
  courses                courses                  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_chapters_course_id_foreign")

  @@index([course_id], map: "course_chapters_course_id_foreign")
}

model course_delete_requests {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_id  BigInt    @db.UnsignedBigInt
  message    String    @db.Text
  status     Boolean   @default(false)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model course_languages {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model course_level_translations {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_level_id BigInt    @db.UnsignedBigInt
  lang_code       String    @db.VarChar(255)
  name            String    @db.VarChar(255)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
}

model course_levels {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  slug       String    @db.VarChar(255)
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model course_live_classes {
  id                      BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  lesson_id               BigInt                   @db.UnsignedBigInt
  start_time              String?                  @db.VarChar(255)
  start_notification_sent Boolean                  @default(false)
  type                    course_live_classes_type @default(zoom)
  is_recurring            Boolean                  @default(false)
  recurring_days          Json?
  recurring_type          String?                  @db.VarChar(255)
  recurring_interval      Int                      @default(1)
  recurring_until         DateTime?                @db.Timestamp(0)
  parent_live_class_id    BigInt?                  @db.UnsignedBigInt
  is_generated_instance   Boolean                  @default(false)
  meeting_id              String?                  @db.VarChar(255)
  password                String?                  @db.VarChar(255)
  join_url                String?                  @db.VarChar(255)
  created_at              DateTime?                @db.Timestamp(0)
  updated_at              DateTime?                @db.Timestamp(0)
  course_chapter_lessons  course_chapter_lessons   @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_live_classes_lesson_id_foreign")

  @@index([is_generated_instance], map: "course_live_classes_is_generated_instance_index")
  @@index([is_recurring], map: "course_live_classes_is_recurring_index")
  @@index([lesson_id], map: "course_live_classes_lesson_id_foreign")
  @@index([parent_live_class_id], map: "course_live_classes_parent_live_class_id_index")
}

model course_partner_instructors {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_id     BigInt    @db.UnsignedBigInt
  instructor_id BigInt    @db.UnsignedBigInt
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
}

model course_progress {
  id         BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt               @db.UnsignedBigInt
  course_id  BigInt?              @db.UnsignedBigInt
  chapter_id BigInt?              @db.UnsignedBigInt
  lesson_id  BigInt?              @db.UnsignedBigInt
  watched    Boolean              @default(false)
  current    Boolean              @default(false)
  type       course_progress_type @default(lesson)
  created_at DateTime?            @db.Timestamp(0)
  updated_at DateTime?            @db.Timestamp(0)
}

model course_reviews {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_id  BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  rating     Int
  review     String    @db.Text
  status     Boolean   @default(false)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model course_selected_filter_options {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_id        BigInt    @db.UnsignedBigInt
  filter_id        BigInt    @db.UnsignedBigInt
  filter_option_id BigInt    @db.UnsignedBigInt
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
}

model course_selected_languages {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_id   BigInt    @db.UnsignedBigInt
  language_id BigInt    @db.UnsignedBigInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model course_selected_levels {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_id  BigInt    @db.UnsignedBigInt
  level_id   BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model courses {
  id                   BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  instructor_id        BigInt                     @db.UnsignedBigInt
  category_id          BigInt?                    @db.UnsignedBigInt
  type                 courses_type               @default(course)
  course_access_type   courses_course_access_type @default(paid)
  title                String                     @db.VarChar(255)
  slug                 String                     @db.VarChar(255)
  seo_description      String?                    @db.VarChar(255)
  start_date           DateTime?                  @db.Date
  duration             Int?
  timezone             String?                    @db.VarChar(255)
  thumbnail            String?                    @db.VarChar(255)
  demo_video_storage   courses_demo_video_storage @default(upload)
  demo_video_source    String?                    @db.Text
  description          String?                    @db.Text
  capacity             Int?
  price                Float?
  discount             Float?
  certificate          Boolean                    @default(false)
  downloadable         Boolean                    @default(false)
  partner_instructor   Boolean                    @default(false)
